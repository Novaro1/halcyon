# Copy to .env and fill in. NEVER commit the real .env.
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Your server's ID (enable Developer Mode → right-click server → Copy ID).
# Set this so slash commands appear instantly; leave blank for global (~1h).
DISCORD_GUILD_ID=
# The access passphrase members get from /links (kept OUT of the public hub).
HALCYON_PASSPHRASE=
# Where the bot reads the current links. After you deploy the gate Worker (see
# ../gate), point this at its PRIVATE endpoint so the bot reads the same gated
# source and the public hub no longer exposes links:
#   LINKS_URL=https://halcyon-gate.<subdomain>.workers.dev/bot/links?key=<BOT_LINKS_SECRET>
LINKS_URL=https://novaro1.github.io/halcyon/links.json

# --- /byod (self-serve bring-your-own-domain) ---
# The verified "Member" role ID — only members with it can run /byod (blank = any
# member). Developer Mode → Server Settings → Roles → right-click Member → Copy ID.
MEMBER_ROLE_ID=
# This server's public IPv4. /byod refuses domains that don't resolve here. If blank
# the bot auto-detects it via api.ipify.org at startup (setting it is more reliable).
HALCYON_SERVER_IP=
# The CNAME target shown to users for subdomains (defaults to the OVH hostname).
HALCYON_CNAME_TARGET=vps-aef380a6.vps.ovh.us
# Optional: channel where /byod ... share:true announces the new domain.
COMMUNITY_LINKS_CHANNEL_ID=
# Max domains a single user can add per day.
BYOD_MAX_PER_DAY=3

# --- #status board + "Check a link" button ---
# The #status channel ID (Developer Mode → right-click #status → Copy Channel ID).
# The bot needs Send Messages permission there. Leave blank to disable the board.
STATUS_CHANNEL_ID=
# How often (minutes) the "all systems operational" line refreshes.
STATUS_INTERVAL_MIN=5
# The gate's landing URL to health-check (defaults to LINKS_URL's origin).
HALCYON_GATE_URL=
